{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_"
      }
    ],
    "typescript/no-explicit-any": "error"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".data/**"],
  "overrides": [
    {
      "files": ["**/*.tsx"],
      "rules": {
        "no-unassigned-vars": "off"
      }
    }
  ]
}
